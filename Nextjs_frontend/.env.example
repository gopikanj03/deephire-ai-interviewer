# Copy this file to .env.local and fill in your own values.
# Never commit the filled-in file — .env* is gitignored.

# Neon / PostgreSQL connection string used by Drizzle ORM.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEXT_PUBLIC_DRIZZLE_DB_URL=

# Google Gemini API key — used for interview question generation
# and answer evaluation. Get one at https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# Google API key used by the client-side speech features.
NEXT_PUBLIC_GOOGLE_API_KEY=

# NOTE: the NEXT_PUBLIC_ prefix exposes these values to the browser.
# Before deploying publicly, move the Gemini call behind a server route
# and drop the prefix so the key stays server-side.
